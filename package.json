{
  "name": "theme1",
  "version": "0.1.0",
  "description": "Original, MIT-licensed admin dashboard theme",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "render": "node scripts/render-pages.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:format",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "audit:licenses": "node scripts/license-audit.mjs",
    "check:budgets": "node scripts/check-budgets.mjs"
  },
  "dependencies": {
    "bootstrap": "^5.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.5",
    "eslint": "^9.9.0",
    "fast-glob": "^3.3.2",
    "globals": "^15.9.0",
    "jsdom": "^24.1.1",
    "nunjucks": "^3.2.4",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "sass": "^1.77.8",
    "stylelint": "^16.8.2",
    "stylelint-config-standard-scss": "^13.1.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
